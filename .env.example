# MongoDB — app-user URI (least privilege; create with scripts/setup-app-user.mjs)
# Placeholder only. Never commit a real URI/credential.
MONGODB_URI=mongodb+srv://attendance_app:<password>@<cluster-host>/?authSource=admin&appName=Cluster0
MONGODB_DB=attendance

# Better Auth
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3000
# Extra origins trusted by better-auth (comma-separated, e.g. a dev/preview tunnel)
BETTER_AUTH_TRUSTED_ORIGINS=
# Dev-only one-click login on /login. Leave blank to hide the block; it is
# always hidden in production regardless of these values.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# QR signing (dual-key rotation: promote PREVIOUS into CURRENT before rotating CURRENT)
QR_SECRET_CURRENT=<openssl rand -hex 32>
QR_SECRET_PREVIOUS=

# Kiosk key (header x-kiosk-key; kiosk page auth via ?key= link + cookie)
KIOSK_KEY=<openssl rand -hex 16>

# Daily-status cron job secret (Vercel Cron sends it as ?cron= / Bearer)
CRON_SECRET=<openssl rand -hex 32>

# Admin bootstrap email — internal-match role override
ADMIN_EMAIL=owner@example.com

# Region / rules
TIMEZONE=Asia/Dhaka
QR_EXPIRY_SECONDS=45
QR_REFRESH_MS=30000
DUPLICATE_SCAN_WINDOW_MIN=2
CHECKIN_RATE_LIMIT=10
# Office geofence — replace with your own coordinates before use
OFFICE_LAT=23.8103
OFFICE_LNG=90.4125
OFFICE_RADIUS_M=150

# GPS fixes coarser than this are refused (metres)
GEOFENCE_MAX_ACCURACY_M=100

# QR mode:
#   dynamic — the kiosk mints a fresh 45s code every 30s. Proves presence at
#             the entrance, but needs a device left switched on at the door.
#   static  — one fixed signed code (print it from /admin/qr). Needs no
#             always-on device, but proves nothing about presence on its own:
#             the device, geofence and fingerprint factors carry that weight.
QR_MODE=dynamic
# Bump to invalidate every printed copy of the static code, then reprint.
STATIC_QR_VERSION=1

# Biometric (WebAuthn) check-in factor:
#   off      — never ask for a fingerprint
#   optional — ask when the device has an enrolled fingerprint
#   required — every employee must enrol and confirm with a fingerprint
#              (individual employees can be exempted on the employee form)
BIOMETRIC_POLICY=off

# WebAuthn relying party. rpID is the domain the fingerprint is bound to:
# change it and every enrolled fingerprint stops working, so set it to the
# production domain before anyone enrols. Defaults to the BETTER_AUTH_URL host.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Office Attendance
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
